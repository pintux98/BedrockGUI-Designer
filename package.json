{
  "name": "bedrockgui-designer-app",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "deploy": "node --input-type=module -e \"import fs from 'node:fs'; try{fs.rmSync('dist/_redirects')}catch{}; try{fs.rmSync('dist/_headers')}catch{}\" && wrangler deploy",
    "test": "vitest run",
    "test:ui": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^7.0.0",
    "@hookform/resolvers": "^3.10.0",
    "js-yaml": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^9.0.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "playwright": "^1.45.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.84.1"
  }
}
